# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required — Bot token from https://discord.com/developers/applications
# Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# Required — Application ID (Client ID) from the Developer Portal > General Information
DISCORD_CLIENT_ID=

# Required for slash command deployment in development mode.
# Developer Portal > your app > General Information, or right-click your
# bot in a server with Developer Mode ON > Copy Server ID.
DISCORD_DEV_GUILD_ID=

# Optional — override the default "eu" locale used in log output.
LOG_LEVEL=info

# Optional — required only by the VALORANT rank feature.
# Create a key at https://api.henrikdev.xyz/dashboard (free "Basic" tier: 30 req/min).
# The key is sent in the `Authorization` header, NOT `X-API-Key`.
HENRIK_DEV_API_KEY=

# ---------------------------------------------------------------------------------------------
# Hosting — only needed for `npm run deploy` against a Pterodactyl panel
# ---------------------------------------------------------------------------------------------
# Copy these from your hosting panel. Never commit the password.

# Panel base URL, no trailing slash.
PANEL_URL=

# Server identifier: the short id in the panel URL, /server/<id>/...
HEAVEN_SERVER_ID=

# Pterodactyl client API key (starts with ptlc_). Used only to restart the server after a deploy.
HEAVEN_CLOUDE_API_KEY=

# SFTP endpoint, from the panel's Settings -> SFTP section.
HEAVEN_SFTP_HOST=
HEAVEN_SFTP_PORT=2022
HEAVEN_SFTP_USER=
# The SFTP password is the password you sign in to the panel with.
HEAVEN_SFTP_PASSWORD=
# Pin the host's SSH key. WinSCP's CLI cannot answer the interactive trust prompt, so it aborts with
# "the server key has not been verified" before sending any credential. Find the fingerprint in the
# WinSCP GUI under Session > Server Details, or leave it empty to accept any key.
# HEAVEN_SFTP_HOST_KEY=ssh-ed25519 255 SHA256:...=
# Where the code lives on the host. The default is right for Pterodactyl.
HEAVEN_REMOTE_DIR=/home/container

# Optional — absolute path to WinSCP.com when it is not in a standard location.
# WINSCP_PATH=

# Optional — default false.
# Privileged gateway intents (GuildMembers, MessageContent, GuildPresences) are
# OFF by default in the Developer Portal. A privileged intent is only requested
# at runtime when BOTH of these hold:
#   1. this flag is true, AND
#   2. a feature under src/features/ declares it in its `requiredIntents`.
#
# Leave this false and the bot runs with no Developer Portal changes at all.
# Set it to true only after ticking the matching toggles in
# Developer Portal > Bot > Privileged Gateway Intents.
ENABLE_PRIVILEGED_INTENTS=false

# Optional — where the SQLite database file lives.
# Default: <project root>/data/bot.db (created automatically, gitignored).
# The path is resolved relative to the code, NOT the working directory, so starting the bot from
# another folder still uses this same file. A relative value here is resolved against the process
# working directory, so prefer an absolute path.
# Set it to :memory: to run with no file at all (everything is lost when the process exits).
DATABASE_PATH=

{
  "name": "discordbot",
  "version": "0.1.0",
  "private": true,
  "description": "Extensible Discord bot with OAuth2 server installation and least-privilege permissions",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:commands": "tsx src/scripts/deploy-commands.ts",
    "invite": "tsx src/scripts/print-invite.ts"
  },
  "dependencies": {
    "discord-api-types": "^0.38.56",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
